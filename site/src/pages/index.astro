---
/**
 * `/` picks a language: the one you chose before, else the browser's, else English.
 * Works on any static host (no server redirects needed); links are there if JS is off.
 */
import { href } from '../lib/links';
const ko = href('/ko/');
const en = href('/en/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aquila Agents</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={href('/icon.svg')} />
    <link rel="alternate" hreflang="ko" href={ko} />
    <link rel="alternate" hreflang="en" href={en} />
    <link rel="alternate" hreflang="x-default" href={en} />
    <noscript><meta http-equiv="refresh" content={`0; url=${en}`} /></noscript>
    <script is:inline define:vars={{ ko, en }}>
      let pick = null;
      try {
        pick = localStorage.getItem('aquila-lang');
      } catch {}
      if (pick !== 'ko' && pick !== 'en') {
        pick = (navigator.languages || [navigator.language]).some((l) => /^ko\b/i.test(l)) ? 'ko' : 'en';
      }
      location.replace((pick === 'ko' ? ko : en) + location.hash);
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #0e1014;
        color: #e4e7ed;
        font-family: system-ui, sans-serif;
      }
      a {
        color: #7aa2f7;
        margin: 0 0.5rem;
      }
    </style>
  </head>
  <body>
    <p><a href={ko} hreflang="ko">한국어</a> · <a href={en} hreflang="en">English</a></p>
  </body>
</html>

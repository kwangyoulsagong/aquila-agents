---
import { ui, type Lang } from '../i18n/ui';
import { href, REPO } from '../lib/links';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].nav;
const other: Lang = lang === 'ko' ? 'en' : 'ko';
const links = [
  { id: 'features', label: t.features },
  { id: 'notes', label: t.notes },
  { id: 'compare', label: t.compare },
  { id: 'faq', label: t.faq },
];
---

<header class="nav" data-nav>
  <div class="nav__inner container">
    <a class="nav__brand" href={href(`/${lang}/`)} aria-label="Aquila Agents">
      <Logo size={28} />
      <span>Aquila Agents</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => <a href={`#${l.id}`}>{l.label}</a>)}
      <a href={href(`/${lang}/docs/`)}>Docs</a>
    </nav>

    <div class="nav__actions">
      <a class="nav__lang" href={href(`/${other}/`)} hreflang={other} lang={other} data-lang-switch>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
          ><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"
          ></path></svg
        >
        <span>{t.language}</span>
      </a>
      <a class="nav__icon" href={REPO} aria-label="GitHub" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
          ></path></svg
        >
      </a>
      <a class="btn btn--primary nav__cta" href="#download">{t.download}</a>
      <button class="nav__burger" type="button" aria-expanded="false" aria-controls="nav-sheet" data-burger>
        <span class="sr-only">{t.menu}</span>
        <i></i><i></i>
      </button>
    </div>
  </div>

  <div class="nav__sheet" id="nav-sheet" data-sheet hidden>
    {links.map((l) => <a href={`#${l.id}`}>{l.label}</a>)}
    <a href={href(`/${lang}/docs/`)}>Docs</a>
    <a href={href(`/${other}/`)} hreflang={other} lang={other} data-lang-switch>{t.language}</a>
    <a class="btn btn--primary btn--lg" href="#download">{t.download}</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition:
      background-color var(--motion-slow) var(--motion-ease),
      border-color var(--motion-slow) var(--motion-ease),
      backdrop-filter var(--motion-slow) var(--motion-ease);
    border-bottom: 1px solid transparent;
    padding-top: env(safe-area-inset-top);
  }
  .nav[data-scrolled],
  .nav[data-open] {
    background: color-mix(in oklab, var(--color-bg-canvas) 72%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom-color: var(--site-line);
  }
  .nav__inner {
    height: var(--site-nav-h);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 1rem;
    flex: none;
  }
  .nav__links {
    display: flex;
    gap: 0.25rem;
    margin-inline: auto;
  }
  .nav__links a,
  .nav__lang,
  .nav__icon {
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    transition:
      color var(--motion-fast) var(--motion-ease),
      background-color var(--motion-fast) var(--motion-ease);
  }
  .nav__links a:hover,
  .nav__lang:hover,
  .nav__icon:hover {
    color: var(--color-text-primary);
    background: var(--color-bg-hover);
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: none;
  }
  .nav__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .nav__lang svg,
  .nav__icon svg {
    width: 1.125rem;
    height: 1.125rem;
  }
  .nav__icon {
    display: inline-flex;
    padding: 0.5rem;
  }
  .nav__cta {
    min-height: 2.25rem;
    padding: 0 1rem;
    margin-left: 0.5rem;
    font-size: 0.875rem;
  }
  .nav__burger {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: none;
    position: relative;
    cursor: pointer;
  }
  .nav__burger i {
    position: absolute;
    left: 0.8125rem;
    right: 0.8125rem;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform var(--motion-medium) var(--motion-ease);
  }
  .nav__burger i:first-of-type {
    top: 1.125rem;
  }
  .nav__burger i:last-of-type {
    bottom: 1.125rem;
  }
  .nav__burger[aria-expanded='true'] i:first-of-type {
    transform: translateY(0.2rem) rotate(45deg);
  }
  .nav__burger[aria-expanded='true'] i:last-of-type {
    transform: translateY(-0.2rem) rotate(-45deg);
  }
  .nav__sheet {
    display: grid;
    gap: 0.25rem;
    padding: 0.5rem var(--site-gutter) 1.5rem;
  }
  .nav__sheet[hidden] {
    display: none;
  }
  .nav__sheet a:not(.btn) {
    padding: 0.875rem 0;
    font-size: 1.0625rem;
    font-weight: 500;
    border-bottom: 1px solid var(--site-line);
  }
  .nav__sheet .btn {
    margin-top: 1rem;
  }

  @media (max-width: 60rem) {
    .nav__links,
    .nav__lang,
    .nav__icon {
      display: none;
    }
    .nav__burger {
      display: inline-block;
    }
    .nav__actions {
      margin-left: auto;
    }
  }
  @media (max-width: 26rem) {
    .nav__cta {
      display: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const sheet = document.querySelector<HTMLElement>('[data-sheet]');

  if (nav) {
    const onScroll = () => nav.toggleAttribute('data-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  function setOpen(open: boolean) {
    if (!nav || !burger || !sheet) return;
    burger.setAttribute('aria-expanded', String(open));
    sheet.hidden = !open;
    nav.toggleAttribute('data-open', open);
  }
  burger?.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
  sheet?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  window.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  window.matchMedia('(min-width: 60.0625rem)').addEventListener('change', (m) => m.matches && setOpen(false));

  // Keep the section you're reading when switching language.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('aquila-lang', a.hreflang);
      } catch {
        /* storage blocked: the link still works */
      }
      if (location.hash) a.href = a.href.split('#')[0] + location.hash;
    });
  });
</script>

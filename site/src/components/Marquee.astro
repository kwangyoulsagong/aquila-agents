---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].marquee;
const items = [
  { name: 'Claude Code', color: 'var(--color-agent-claude)' },
  { name: 'Codex CLI', color: 'var(--color-agent-codex)' },
  { name: 'zsh', color: 'var(--color-agent-shell)' },
  { name: 'bash', color: 'var(--color-agent-shell)' },
  { name: 'git worktree', color: 'var(--color-status-waiting)' },
  { name: 'tmux', color: 'var(--color-status-done)' },
  { name: 'SSH', color: 'var(--color-action-primary)' },
  { name: 'MCP', color: 'var(--color-account-personal)' },
  { name: 'Figma', color: 'var(--color-agent-claude)' },
  { name: 'CLAUDE.md', color: 'var(--color-agent-claude)' },
  { name: 'AGENTS.md', color: 'var(--color-agent-codex)' },
  { name: 'Markdown', color: 'var(--color-text-secondary)' },
];
---

<section class="marquee" aria-label={t.label}>
  <p class="marquee__label">{t.label}</p>
  <div class="marquee__track">
    {
      [0, 1].map((copy) => (
        <ul class="marquee__row" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((it) => (
            <li style={`--c:${it.color}`}>
              <span class="marquee__dot" />
              {it.name}
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .marquee {
    padding-block: 2.5rem;
    border-block: 1px solid var(--site-line);
    background: color-mix(in oklab, var(--color-bg-surface) 40%, transparent);
  }
  .marquee__label {
    margin: 0 0 1.25rem;
    text-align: center;
    font-size: var(--site-text-small);
    color: var(--color-text-tertiary);
  }
  .marquee__track {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 12%, black 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 12%, black 88%, transparent);
  }
  .marquee__row {
    display: flex;
    gap: 0.75rem;
    padding: 0 0.375rem;
    margin: 0;
    list-style: none;
    flex: none;
    animation: slide 40s linear infinite;
  }
  .marquee:hover .marquee__row {
    animation-play-state: paused;
  }
  .marquee__row li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--site-line);
    background: var(--site-card);
    font-family: var(--font-family-mono);
    font-size: 0.875rem;
    white-space: nowrap;
    color: var(--color-text-secondary);
  }
  .marquee__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0.75rem var(--c);
  }
  @keyframes slide {
    to {
      transform: translateX(-100%);
    }
  }
</style>

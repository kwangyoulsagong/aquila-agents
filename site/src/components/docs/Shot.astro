---
/**
 * A guide screenshot or loop inside a docs page, in the page's language:
 *   import Shot from '~/components/docs/Shot.astro';
 *   <Shot id="split" caption="Two agents side by side" />
 * `id` is a guide media name (src/features/guide/media/<id>.<lang>.webp|webm in the app).
 */
import { media } from '../../lib/media';
import { isLang } from '../../i18n/ui';

interface Props {
  id: string;
  caption?: string;
}
const { id, caption } = Astro.props;
const lang = isLang(Astro.currentLocale) ? Astro.currentLocale : 'en';
const m = media(id, lang);
---

<figure class="shot not-content">
  {
    m.kind === 'video' ? (
      <video src={m.src} poster={m.poster} muted loop playsinline autoplay preload="metadata" width="960" height="600" aria-label={caption ?? id} />
    ) : (
      <img src={m.src} alt={caption ?? id} loading="lazy" decoding="async" width="960" height="600" />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: 1.5rem 0;
  }
  .shot img,
  .shot video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-container);
    border: 1px solid var(--color-border-subtle);
    background: var(--color-bg-surface);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--color-text-tertiary);
    text-align: center;
  }
  @media (prefers-reduced-motion: reduce) {
    video {
      /* autoplay is ignored by most browsers here; the poster stays */
    }
  }
</style>

<script>
  // Respect reduced motion: stop autoplaying loops.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('.shot video').forEach((v) => {
      v.pause();
      v.removeAttribute('autoplay');
    });
  }
</script>

---
import { ui, type Lang } from '../i18n/ui';
import Media from './Media.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].notes;
---

<section class="section notes" id="notes" aria-labelledby="notes-title">
  <div class="notes__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="notes__head" data-reveal>
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 id="notes-title" class="h2 grad">{t.title}</h2>
      <p class="lead">{t.sub}</p>
    </div>

    <div class="notes__bento">
      <article class="card spot notes__big" data-spot data-reveal>
        <div class="notes__text">
          <h3>{t.big.title}</h3>
          <p>{t.big.body}</p>
        </div>
        <div class="notes__media notes__media--big">
          <Media id="graph" lang={lang} alt={t.big.title} />
        </div>
      </article>
      {
        t.cards.map((c, i) => (
          <article class="card spot notes__card" data-spot data-reveal style={`--i:${i + 1}`}>
            <div class="notes__text">
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </div>
            <div class="notes__media">
              <Media id={c.id} lang={lang} alt={c.title} />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .notes {
    overflow: clip;
  }
  .notes__glow {
    position: absolute;
    inset: 20% -20% auto;
    height: 60%;
    background: radial-gradient(40% 50% at 50% 50%, color-mix(in oklab, var(--color-account-personal) 14%, transparent), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
    z-index: -1;
  }
  .notes__head {
    max-width: 42rem;
  }
  .notes__bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }
  .notes__big {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.6fr);
    align-items: center;
  }
  .notes__card {
    display: flex;
    flex-direction: column;
  }
  .notes__text {
    padding: clamp(1.5rem, 1.25rem + 1vw, 2.25rem);
  }
  .notes__text h3 {
    margin: 0;
    font-size: var(--site-text-h3);
    letter-spacing: -0.02em;
  }
  .notes__text p {
    margin: 0.5rem 0 0;
    color: var(--color-text-secondary);
  }
  .notes__media {
    margin: auto 0 0 1.5rem;
    border-top-left-radius: var(--radius-container);
    border-top: 1px solid var(--site-line);
    border-left: 1px solid var(--site-line);
    overflow: hidden;
    transition: transform 0.6s var(--site-ease-out);
  }
  .notes__card:hover .notes__media,
  .notes__big:hover .notes__media {
    transform: translate(-0.25rem, -0.25rem);
  }
  .notes__media--big {
    margin: 1.5rem 0 0 0;
    align-self: end;
  }
  .notes__media :global(img),
  .notes__media :global(video) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }
  @media (max-width: 56rem) {
    .notes__bento {
      grid-template-columns: minmax(0, 1fr);
    }
    .notes__big {
      grid-template-columns: minmax(0, 1fr);
    }
    .notes__media--big {
      margin-left: 1.5rem;
    }
  }
</style>

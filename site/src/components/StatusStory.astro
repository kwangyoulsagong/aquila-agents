---
/**
 * Scroll story: text steps scroll on the left while the screen on the right stays put and swaps to
 * the step you're reading. Sticky + IntersectionObserver (no scroll-jacking); on narrow screens each
 * step carries its own screenshot instead.
 */
import { ui, type Lang } from '../i18n/ui';
import Media from './Media.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].status;
const ids = ['status', 'attention', 'notify', 'review'];
const legend = [
  ['working', t.legend.working],
  ['waiting', t.legend.waiting],
  ['error', t.legend.error],
  ['done', t.legend.done],
] as const;
---

<section class="section story" aria-labelledby="story-title" data-story>
  <div class="container">
    <div class="story__intro" data-reveal>
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 id="story-title" class="h2 grad">{t.title}</h2>
      <p class="lead">{t.sub}</p>
      <ul class="story__legend">
        {
          legend.map(([s, label]) => (
            <li>
              <span class="dot" data-s={s} />
              {label}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="story__body">
      <ol class="story__steps">
        {
          t.steps.map((s, i) => (
            <li class="story__step" data-step={i} aria-current={i === 0 ? 'step' : undefined}>
              <span class="story__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>
                {s.title}
                {s.kbd && <span class="kbd">{s.kbd}</span>}
              </h3>
              <p>{s.body}</p>
              <div class="frame story__inline">
                <Media id={ids[i]} lang={lang} alt={s.title} />
              </div>
            </li>
          ))
        }
      </ol>

      <div class="story__screen" aria-hidden="true">
        <div class="frame story__frame">
          {
            ids.map((id, i) => (
              <div class:list={['story__shot', { 'is-active': i === 0 }]} data-shot={i}>
                <Media id={id} lang={lang} alt="" />
              </div>
            ))
          }
        </div>
        <div class="story__progress">
          {ids.map((_, i) => <i class:list={{ 'is-active': i === 0 }} data-pip={i} />)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .story__intro {
    max-width: 40rem;
  }
  .story__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }
  .story__legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    border: 1px solid var(--site-line);
    background: var(--site-card);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .story__body {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    margin-top: clamp(2rem, 1rem + 4vw, 4rem);
  }
  .story__steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .story__step {
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 1.5rem;
    border-left: 2px solid var(--site-line);
    opacity: 0.35;
    transition:
      opacity var(--motion-slow) var(--motion-ease),
      border-color var(--motion-slow) var(--motion-ease);
  }
  .story__step[aria-current='step'] {
    opacity: 1;
    border-left-color: var(--color-action-primary);
  }
  .story__num {
    font-family: var(--font-family-mono);
    font-size: 0.8125rem;
    color: var(--color-action-primary);
  }
  .story__step h3 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0.5rem 0 0;
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem);
    letter-spacing: -0.03em;
  }
  .story__step p {
    margin: 0.75rem 0 0;
    color: var(--color-text-secondary);
    font-size: var(--site-text-lead);
    max-width: 26rem;
  }
  .story__inline {
    display: none;
  }

  .story__screen {
    position: sticky;
    top: max(calc(var(--site-nav-h) + 1.5rem), calc(50vh - 15rem));
    align-self: start;
    margin-top: 12vh;
  }
  .story__frame {
    aspect-ratio: 16 / 10;
  }
  .story__shot {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(0.98) translateY(0.75rem);
    transition:
      opacity 0.5s var(--site-ease-out),
      transform 0.7s var(--site-ease-out);
  }
  .story__shot.is-active {
    opacity: 1;
    transform: none;
  }
  .story__shot :global(img),
  .story__shot :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  .story__progress {
    display: flex;
    gap: 0.375rem;
    justify-content: center;
    margin-top: 1.25rem;
  }
  .story__progress i {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--color-border-default);
    transition:
      width var(--motion-slow) var(--motion-ease),
      background-color var(--motion-slow) var(--motion-ease);
  }
  .story__progress i.is-active {
    width: 1.5rem;
    background: var(--color-action-primary);
  }

  @media (max-width: 56rem) {
    .story__body {
      grid-template-columns: minmax(0, 1fr);
    }
    .story__screen {
      display: none;
    }
    .story__step {
      min-height: 0;
      opacity: 1;
      padding: 0 0 3rem;
      border-left: 0;
    }
    .story__inline {
      display: block;
      margin-top: 1.5rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-story]').forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const shots = [...root.querySelectorAll<HTMLElement>('[data-shot]')];
    const pips = [...root.querySelectorAll<HTMLElement>('[data-pip]')];
    const activate = (i: number) => {
      steps.forEach((s, k) => (k === i ? s.setAttribute('aria-current', 'step') : s.removeAttribute('aria-current')));
      shots.forEach((s, k) => s.classList.toggle('is-active', k === i));
      pips.forEach((p, k) => p.classList.toggle('is-active', k === i));
    };
    // A step is "current" while it crosses the middle band of the viewport.
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) activate(Number((e.target as HTMLElement).dataset.step));
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    steps.forEach((s) => io.observe(s));
  });
</script>

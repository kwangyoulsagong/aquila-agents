---
import '../styles/site.css';
import { ui, LANGS, type Lang } from '../i18n/ui';
import { href, AUTHOR } from '../lib/links';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const canonical = Astro.site ? new URL(href(`/${lang}/`), Astro.site).href : undefined;
const og = Astro.site ? new URL(href('/og.png'), Astro.site).href : href('/og.png');
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="author" content={AUTHOR} />
    <meta name="theme-color" content="#0e1014" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" href={href('/icon.png')} />
    <link rel="apple-touch-icon" href={href('/icon.png')} />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      LANGS.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={Astro.site ? new URL(href(`/${l}/`), Astro.site).href : href(`/${l}/`)}
        />
      ))
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
